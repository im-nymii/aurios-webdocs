---
---
[
  {% assign docs = site.docs | sort: 'url' %}
  {% for doc in docs %}
  {
    "title": {{ doc.title | default: doc.name | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "content": {{ doc.content | strip_html | normalize_whitespace | truncatewords: 120 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
